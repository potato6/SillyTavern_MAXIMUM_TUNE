{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "singleQuote": true,
    "semi": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "bracketSpacing": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "arrowParens": "always",
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.git/**",
        "public/lib/**",
        "backups/**",
        "data/**",
        "cache/**",
        "src/tokenizers/**",
        "docker/**",
        "plugins/**",
        "**/*.min.js",
        "public/scripts/extensions/**",
        "public/dist/**",
        "**/*.d.ts",
        "public/scripts/extensions/quick-reply/lib/**",
        "public/scripts/extensions/tts/lib/**"
    ]
}
